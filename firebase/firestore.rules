rules_version = '2';

// Security rules for The Rise of Freny.
// Publish them in the Firebase console (Firestore Database > Rules)
// or with `firebase deploy --only firestore:rules` from this folder.
service cloud.firestore {
  match /databases/{database}/documents {

    // One board per arena difficulty (leaderboard_hard, _freny, _medium, _easy), with one
    // entry per player holding their best score there. Anyone can read a board; a player can
    // only write their own entry, and the score can only go up.
    // A new score needs the run ticket below for the same board, and has to fit in the real
    // time since that run started (maxScoreAfter). updatedAt is the server's clock, and an entry
    // takes at most one write every 20 s. Renaming (only "name" changes) needs no ticket.
    // "leaderboard" is the old board that mixed every difficulty: still readable, no longer writable.
    match /{board}/{userId} {
      allow read: if isBoard(board) || board == 'leaderboard';
      allow create: if isBoard(board) && isOwner(userId) && validEntry() && scoreFitsRun(board, userId);
      allow update: if isBoard(board) && isOwner(userId) && validEntry()
                    && request.time > resource.data.get('updatedAt', timestamp.value(0)) + duration.value(20, 's')
                    && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
                        || (request.resource.data.score >= resource.data.score && scoreFitsRun(board, userId)));
      allow delete: if false;
    }

    // Run ticket: the game writes it when a manual arena run starts, with the server's time.
    // It is what scoreFitsRun measures the run against.
    match /runs/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
                            && request.resource.data.keys().hasOnly(['board', 'startedAt'])
                            && isBoard(request.resource.data.board)
                            && request.resource.data.startedAt == request.time;
      allow delete: if false;
    }

    // Each player's profile and lifetime stats, private to them.
    match /saves/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validSave();
      allow delete: if false;
    }

    // The player's three save slots (coins, XP, upgrades, stages), private to them.
    // "slots" is the JSON written by CloudProgressSync.
    match /progress/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
                            && request.resource.data.keys().hasOnly(['slots', 'updatedAt'])
                            && request.resource.data.slots is string
                            && request.resource.data.slots.size() <= 200000;
      allow delete: if false;
    }

    function isBoard(board) {
      return board in ['leaderboard_hard', 'leaderboard_freny', 'leaderboard_medium', 'leaderboard_easy'];
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validEntry() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'score', 'updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 16
          && d.score is int && d.score >= 0 && d.score <= 10000000
          && d.updatedAt == request.time;
    }

    // The score was reached in the run whose ticket is on this board, in the time it has lasted.
    function scoreFitsRun(board, userId) {
      let path = /databases/$(database)/documents/runs/$(userId);
      return exists(path)
          && get(path).data.board == board
          && request.resource.data.score <= maxScoreAfter((request.time - get(path).data.startedAt).seconds());
    }

    // Most points a run can make in s seconds. The combo grows with every kill, so the score
    // grows faster the longer a run lasts.
    function maxScoreAfter(s) {
      return s * (1000 + 20 * s);
    }

    function validSave() {
      let d = request.resource.data;
      return d.keys().hasOnly(['playerName', 'bestScore', 'runsPlayed', 'totalCoins', 'updatedAt'])
          && d.playerName is string && d.playerName.size() <= 16
          && d.bestScore is int && d.runsPlayed is int && d.totalCoins is int;
    }
  }
}
